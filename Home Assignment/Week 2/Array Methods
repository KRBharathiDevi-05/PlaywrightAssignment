let listName = ["Bharathi", 4.93,"f","true"];
listName.push(92);
console.log("Push:" ,listName); // add element at the end of array
listName.pop();
console.log("Pop:" ,listName); // remove element at the end of the array
listName.shift();
console.log("Shift:" ,listName); // remove the beginning element of the array
listName.unshift("Java");
console.log("Unshift:" ,listName); // add the beginning element of the array
console.log("Includes :" , listName.includes('t')); // where the element exist or not // out:false
console.log("Index of: " , listName.indexOf(4.93)); // tells the index of the given element
console.log("Join :" , listName.join( )); // to convert array into string
console.log("Reverse: " , listName.reverse());// to reverse the array
console.log("Sort :" , listName.sort()); // to sort the array

